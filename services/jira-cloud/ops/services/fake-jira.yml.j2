image: rust:1-bookworm
working_dir: /work
volumes:
  - {{ repo }}:/work
  - cargo-registry:/usr/local/cargo/registry
  - target:/work/target
command: ["cargo", "xtask", "fake-jira", "--port", "8787"]
healthcheck:
  test: ["CMD-SHELL", "curl -s -o /dev/null http://127.0.0.1:8787/rest/api/3/myself || exit 1"]
  interval: 5s
  timeout: 3s
  retries: 120
